{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiaoyao-xiaocha-sticker-mcp-v2",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "STICKERS",
      "id": "327f4ed63209417491d384209f9841fa"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html", "**/*.global.js"],
      "fallthrough": true
    }
  ]
}
